{
  "name": "dataset-config",
  "version": "1.3.0",
  "description": "Parse HTML data attributes into a structured object with automatic type conversion.",
  "keywords": [
    "HTML element",
    "attribute-parser",
    "camelcase",
    "data attribute",
    "data attributes",
    "data attrs",
    "data-conversion",
    "data-extraction",
    "data-parser",
    "data-to-object",
    "data-utils",
    "dataset",
    "deep-object",
    "dom-data",
    "exclude-keys",
    "html-data",
    "prefix-filter",
    "type-parsing"
  ],
  "bugs": {
    "url": "https://github.com/ColorlabHQ/dataset-config/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColorlabHQ/dataset-config.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "build:base": "rolldown -c",
    "build:min": "cross-env NODE_ENV=production run-s build:base",
    "build": "run-s clean build:* size",
    "test": "vitest --coverage --ui",
    "coverage": "vitest run --coverage",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.7",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^13.0.3",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm coverage && pnpm build"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
